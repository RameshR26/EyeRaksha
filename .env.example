# EyeRaksha Environment Variable Configuration Template

# Frontend (Static Site on Render)
# URL pointing to the Node.js backend API
VITE_API_BASE_URL=https://eyeraksha-backend.onrender.com/api

# Backend (Web Service on Render)
# PORT is automatically injected by Render (e.g. 10000)
PORT=8080
# Allowed frontend CORS origins (comma-separated if multiple)
CORS_ORIGIN=https://eyeraksha-frontend.onrender.com
# URL pointing to the Python screening adapter service endpoint
MATLAB_SCREENING_ADAPTER_URL=https://eyeraksha-python-service.onrender.com/api/screen

# Python Screening Service (Web Service on Render)
# HOST and PORT for local testing or custom deployment
HOST=0.0.0.0
PORT=5000
